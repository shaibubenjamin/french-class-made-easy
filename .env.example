# ---- Browser (exposed to the SPA; safe to publish) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional analytics (PostHog). Leave empty to disable.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ---- Server only (Netlify Functions) — never prefix with VITE_ ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=sk-ant-...
RESEND_API_KEY=re_...
# Signing secret from the Resend webhook settings (starts with whsec_)
RESEND_WEBHOOK_SECRET=whsec_...
EMAIL_FROM="Parlons <bonjour@mail.example.com>"
# Public URL of the site (Netlify also sets URL automatically in production)
APP_URL=http://localhost:8888
# Long random strings: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
UNSUBSCRIBE_SECRET=change-me
INTERNAL_SECRET=change-me-too
# Where lesson-generation failures are reported
ALERT_EMAIL=you@example.com
